# Local paths used when the Go API runs outside Docker.
# Inside Compose these are overridden by the service environment.
AC_SERVER_INI_PATH=runtime/data/cfg/server_cfg.ini
AC_SERVER_YAML_PATH=runtime/data/cfg/extra_cfg.yml
AC_CONTENT_PATH=runtime/data/content
AC_PRESETS_PATH=runtime/data/presets.json
AC_LOGS_PATH=runtime/data/logs

# Distribution zips packaged for Content Manager (<id>.zip).
# Inside Compose this is overridden to /data/downloads.
AC_DOWNLOADS_PATH=runtime/data/downloads

# Public base URL Content Manager clients use to download those zips.
# The file name /<id>.zip is appended. Use a host players can reach.
PUBLIC_DOWNLOAD_BASE_URL=http://127.0.0.1:8086/downloads

# Optional override for cm_content/content.json. When unset, the API writes
# both <server>/cm_content/content.json and <cfg>/cm_content/content.json.
# AC_CM_CONTENT_JSON=runtime/data/cm_content/content.json

# Optional Vite/frontend log to tail. If unset or missing, the API skips it.
# FRONTEND_LOG_PATH=frontend/frontend.log

# Host checkout used by upgrade commands (`docker compose --project-directory`).
# Defaults to /app/host when the API runs inside the backend container.
HOST_PROJECT_DIR=.

# Host port published by kommander-frontend (see the root .env.example).
KOMMANDER_PORT=8086

# Official AssettoServer image. Override for a Patreon/custom build.
ASSETTOSERVER_IMAGE=compujuckel/assettoserver:latest

PORT=8080
