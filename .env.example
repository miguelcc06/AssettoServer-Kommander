# AssettoServer image. The official image ships built-in plugins only
# (RandomWeatherPlugin, AutoModerationPlugin, DiscordAuditPlugin, LiveWeatherPlugin).
# Override with a Patreon image when you need premium plugins.
ASSETTOSERVER_IMAGE=compujuckel/assettoserver:latest

# Absolute host path of this repository. The backend uses it as
# `docker compose --project-directory` through the mounted Docker socket.
# Leave empty to default to the directory where Compose is launched.
HOST_PROJECT_DIR=

# Host port for the Kommander web UI (mapped to container port 80).
KOMMANDER_PORT=8086

# Public base URL of the Content Manager download zips.
# Kommander appends /<id>.zip. Point this at the host players can reach
# (the frontend serves /downloads/ from AC_DOWNLOADS_PATH).
PUBLIC_DOWNLOAD_BASE_URL=http://127.0.0.1:8086/downloads
